DATABASE_URL=postgresql+psycopg://localhost/reposcope
TEST_DATABASE_URL=postgresql+psycopg://localhost/reposcope_test

# The repository the tools serve. REPO_SUBPATH and REPO_EXTENSIONS must match what was ingested,
# which is why `reposcope ingest` defaults to these values.
REPO_ROOT=~/Desktop/hadoop
REPO_SUBPATH=hadoop-mapreduce-project/hadoop-mapreduce-client/hadoop-mapreduce-client-core/src/main/java/org/apache/hadoop/mapreduce
REPO_EXTENSIONS=.java
